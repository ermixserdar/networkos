{
  "name": "networkos",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "build:ios": "eas build -p ios --profile production",
    "build:android": "eas build -p android --profile production",
    "build:all": "eas build --profile production",
    "submit:ios": "eas submit -p ios --latest",
    "submit:android": "eas submit -p android --latest",
    "testflight": "eas build -p ios --profile production --submit",
    "metadata:pull": "eas metadata:pull",
    "metadata:push": "eas metadata:push"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^4.1.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "buffer": "^6.0.3",
    "d3-force": "^3.0.0",
    "expo": "~55.0.0",
    "expo-contacts": "~55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-sqlite": "~55.0.20",
    "react": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "^0.7.4",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.25",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "expo-modules-core": "~55.0.26",
    "hermes-compiler": "^250829098.0.17",
